# Template: replace the demo hostname and certificate paths before installation.
server {
    listen 80;
    server_name hoodi.example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name hoodi.example.invalid;
    ssl_certificate /etc/letsencrypt/live/hoodi.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hoodi.example.invalid/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        # Exactly one trusted loopback proxy. Overwrite user-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
