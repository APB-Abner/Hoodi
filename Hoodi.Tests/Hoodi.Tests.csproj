<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hoodi.Api\Hoodi.Api.csproj" />
    <ProjectReference Include="..\Hoodi.Application\Hoodi.Application.csproj" />
    <ProjectReference Include="..\Hoodi.Domain\Hoodi.Domain.csproj" />
    <ProjectReference Include="..\Hoodi.Infrastructure\Hoodi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\data\risk\v2\*" Link="RiskFixture\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\risk\v3\*" Link="RiskFixtureV3\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\routes\v2\*" Link="RouteFixture\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\routes\v3\*" Link="RouteFixture\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
